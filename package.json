{
  "name": "praxis-architect",
  "private": true,
  "version": "0.1.0-alpha.49.2",
  "description": "Praxis Architect Skills plugin and praxis-architect.zip",
  "workspaces": [
    "plugins/*",
    "tools/scripts"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "plugins:validate": "node tools/scripts/validate-plugins.mjs",
    "pack:zip": "node tools/scripts/pack-claude-plugins.mjs --version 0.1.0-alpha.49.2",
    "pack:full-zip": "node tools/scripts/pack-claude-plugins.mjs --version 0.1.0-alpha.49.2 --full praxis-architect --out dist/claude-plugins-full/praxis-architect.zip",
    "check:skill-cli": "node tools/scripts/check-skill-cli.mjs",
    "check:boundaries": "node tools/scripts/check-boundaries.mjs",
    "accept:claude-plugins": "node tools/scripts/claude-plugins-acceptance.mjs",
    "accept:claude-hosted-plugins": "node tools/scripts/claude-hosted-plugins-acceptance.mjs",
    "accept:architecture-governance": "node tools/scripts/architecture-governance-acceptance.mjs --rebuild",
    "verify": "npm run test && npm run plugins:validate && npm run check:skill-cli && npm run check:boundaries && npm run pack:zip && npm run pack:full-zip && npm run accept:claude-plugins && npm run accept:plugin-validate && npm run accept:architecture-governance",
    "check:version": "node tools/scripts/check-ecosystem-version.mjs",
    "accept:plugin-validate": "node tools/scripts/plugin-validate-acceptance.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@praxis/plugin-sdk": "file:vendor/praxis-plugin-sdk-0.1.0-alpha.49.2.tgz",
    "@praxis/knowledge": "file:vendor/praxis-knowledge-0.1.0-alpha.49.2.tgz",
    "@praxis/project-config": "file:vendor/praxis-project-config-0.1.0-alpha.49.2.tgz",
    "@praxis/contracts": "file:vendor/praxis-contracts-0.1.0-alpha.49.2.tgz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfg-inc/praxis-architect.git"
  },
  "bugs": {
    "url": "https://github.com/dfg-inc/praxis-architect/issues"
  },
  "homepage": "https://github.com/dfg-inc/praxis-architect"
}
